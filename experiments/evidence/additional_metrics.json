{
  "definitions": {
    "malformed_calls": "Count each recorded tool_call whose input violates the frozen historical input schema (JSON object/type/required/enum/extra-property rules, string pattern, maxItems or numeric minimum). Count attempted calls, not plan graph validation or business errors. Per-run counts sum to the arm total.",
    "boundary_rejections": "Count recorded tool_call errors with structured protocol kind (or legacy structured metadata), including loop guards. No classification uses error prose.",
    "semantic_wrong_arguments": "Reviewed inventory of wrong recipient plan steps and failed revisions, missing named report figures, incorrect named revenue figures/differences, and invalid report references. Each distinct argument candidate is one unit; several wrong fields in that candidate still count once. Count all model-produced plan steps including rejected/never-executed steps, revisions, and tool attempts separately by stage. Critique-approved copies are excluded. Arm totals are inventory counts, not a comprehensive narrative correctness score; narrative assertions and decoding-option choices are outside this inventory.",
    "semantic_wrong_argument_runs": "Distinct runs containing at least one annotated candidate; historical passes/check scores are preserved even when the inventory identifies an additional semantic defect.",
    "initial_task_false_finish": "Run check failed and the initial operator turn ended done, read from physical end events before the next operator turn. Historical endpoint false_finishes remains a separate metric.",
    "proposal_rejections": "Plan events with accepted:false; terminal plan_rejected and replan_bound are counted separately.",
    "hashes": "SHA-256 after replacing CRLF with LF only, without JSON reserialization; original LF or CRLF byte hashes are verified and retained as provenance."
  },
  "hash_policy": "sha256 of bytes after CRLF-to-LF normalization only; preserve all other bytes",
